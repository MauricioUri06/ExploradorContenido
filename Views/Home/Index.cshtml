@{
    ViewData["Title"] = "Inicio";
}

<div class="row row-cols-1 row-cols-md-2 g-4">
    <div class="col">
        <article class="card h-100 shadow-sm tarjeta" id="seccion-citas">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Citas y autores</h2>
                <span class="badge rounded-pill text-bg-light border">DummyJSON</span>
            </div>
            <div class="card-body zona-texto">
                <p class="estado" role="status" aria-live="polite"></p>
                <figure class="contenido mb-0" hidden>
                    <blockquote class="blockquote">
                        <p id="texto-cita"></p>
                    </blockquote>
                    <figcaption class="blockquote-footer mb-0" id="autor-cita"></figcaption>
                </figure>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <button type="button" class="btn btn-primary w-100" id="boton-cita">Obtener otra cita</button>
            </div>
        </article>
    </div>

    <div class="col">
        <article class="card h-100 shadow-sm tarjeta" id="seccion-perros">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Imágenes de perros</h2>
                <span class="badge rounded-pill text-bg-light border">Dog CEO</span>
            </div>
            <div class="card-body">
                <div class="marco-imagen">
                    <p class="estado" role="status" aria-live="polite"></p>
                    <img class="contenido" id="imagen-perro" alt="" hidden />
                </div>
                <p class="small text-body-secondary text-center mt-2 mb-0" id="raza-perro"></p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <button type="button" class="btn btn-primary w-100" id="boton-perro">Mostrar otro perro</button>
            </div>
        </article>
    </div>

    <div class="col">
        <article class="card h-100 shadow-sm tarjeta" id="seccion-gatos">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Imágenes de gatos</h2>
                <span class="badge rounded-pill text-bg-light border">CATAAS</span>
            </div>
            <div class="card-body">
                <div class="marco-imagen">
                    <p class="estado" role="status" aria-live="polite"></p>
                    <img class="contenido" id="imagen-gato" alt="" hidden />
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <button type="button" class="btn btn-primary w-100" id="boton-gato">Mostrar otro gato</button>
            </div>
        </article>
    </div>

    <div class="col">
        <article class="card h-100 shadow-sm tarjeta" id="seccion-datos">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Datos curiosos</h2>
                <span class="badge rounded-pill text-bg-light border">Useless Facts</span>
            </div>
            <div class="card-body zona-texto">
                <p class="estado" role="status" aria-live="polite"></p>
                <p class="contenido fs-5 mb-0" id="texto-dato" hidden></p>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <button type="button" class="btn btn-primary w-100" id="boton-dato">Mostrar otro dato</button>
            </div>
        </article>
    </div>
</div>

@section Scripts {
    <script src="~/js/explorador.js" asp-append-version="true"></script>
}
